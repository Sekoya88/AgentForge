# Copy to repo root: cp .env.example .env
# Local stack: ./scripts/dev-up.sh  (Docker: db + redis + alembic)
#
# Backend
# Use port 5433 / 6380 when using `docker compose up -d db redis` from this repo.
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5433/agentforge
REDIS_URL=redis://localhost:6380/0
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Frontend dev URLs (comma-separated). Include both if you switch between localhost and 127.0.0.1.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002
# Chrome sends Access-Control-Request-Private-Network on some cross-origin calls; keep true for local dev.
CORS_ALLOW_PRIVATE_NETWORK=true
# Any port on localhost / 127.0.0.1 (Next dev often uses 3001 if 3000 is taken). Set to empty to disable.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Red-team: mock (default, synthetic scores — not real attacks) | promptfoo (requires npx + promptfoo)
REDTEAM_MODE=mock

# Sandbox runtime: subprocess (default) | docker (isolated container, requires Docker daemon)
SANDBOX_MODE=subprocess

# Optional — LLM keys (orchestrator + /api/v1/knowledge/ingest embeddings)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Gemini / Google GenAI SDK
GOOGLE_API_KEY=

# Optional — Modal (fine-tuning on GPU). Install: pip install modal; deploy train.py from repo backend/.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Set true only when Modal is configured and train app is deployed (spawns real GPU jobs).
MODAL_ENABLED=false
# After `cd backend && modal deploy modal_functions/inference.py`, paste the printed URL here.
# Format: https://<workspace>--agentforge-inference-generate.modal.run
MODAL_INFERENCE_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability -- Langfuse LLM tracing (optional, leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Send X-Correlation-ID on requests; responses echo it. API emits JSON access logs (structlog)
# for non-health routes: event http_request, fields method, path, status_code, duration_ms, correlation_id.
#
# Optional — Sentry (backend only). Leave unset to disable.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_ENVIRONMENT=development

# Sentry (frontend) — optional, leave blank to disable
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Sentry source maps upload (CI/prod only — set as repo secrets)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
