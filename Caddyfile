{
    # Global options
    email {$CADDY_ACME_EMAIL}
}

{$CADDY_DOMAIN} {
    # Route API and WebSocket traffic to backend
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }

    # Route everything else to frontend
    handle {
        reverse_proxy frontend:3000
    }
}
